# 실제 값이 없는 설정 예시. .env로 복사한 후 개인 환경에서만 채운다.
# 기존 DB 비밀번호와 JWT 서명키를 임의로 재생성하거나 변경하지 않는다.
DB_URL=jdbc:mysql://localhost:3306/momo_db?serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_ACCESS_EXP_MS=1800000
JWT_REFRESH_EXP_MS=604800000
KOBIS_API=
KMDB_API=
TMDB_API=
MOMO_CORS_ALLOWED_ORIGINS=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/oauth/naver
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google

# 로컬 기본 실행은 update 호환을 유지한다. 스키마 마이그레이션 작업 후 validate로 전환한다.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
MOMO_EXTERNAL_API_RATE_LIMIT_PER_MINUTE=60
MOMO_POSTER_ENSURE_RATE_LIMIT_PER_MINUTE=5

# 카카오 탈퇴 연결 해제에만 사용하는 서버 전용 Admin Key
KAKAO_ADMIN_KEY=
