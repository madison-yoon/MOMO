# 실제 값이 없는 설정 예시. .env로 복사한 후 개인 환경에서만 채운다.
# 기존 DB 비밀번호와 JWT 서명키를 임의로 재생성하거나 변경하지 않는다.
DB_URL=jdbc:mysql://localhost:3306/momo_db?serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_ACCESS_EXP_MS=1800000
JWT_REFRESH_EXP_MS=604800000
KOBIS_API=
KMDB_API=
TMDB_API=
MOMO_CORS_ALLOWED_ORIGINS=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/oauth/naver
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google

# 카카오 회원 탈퇴 연결 해제 전용 서버 Admin Key. 실제 값은 .env에서만 관리합니다.
KAKAO_ADMIN_KEY=

# RAG 6차시: 개발/자동 테스트는 stub, 실제 Atlas 연동은 atlas
RAG_ENGINE=stub
RAG_ENABLED=false
RAG_BASE_URL=http://127.0.0.1:8000
RAG_SERVICE_TOKEN=
# 엔진 전환 시 초기 재색인이 끝날 때까지 false로 질문 진입 차단
RAG_QUERY_ENABLED=true
RAG_CONNECT_TIMEOUT_MS=500
RAG_QUERY_CONNECT_TIMEOUT_MS=500
# 미설정 기본값: stub 색인 1000/질문 10000, atlas 색인 15000/질문 30000(ms)
# RAG_READ_TIMEOUT_MS=15000
# RAG_QUERY_READ_TIMEOUT_MS=30000
# 운영자 ID는 서버에서만 설정하며 프론트에는 권한 boolean만 제공
RAG_REINDEX_ENABLED=false
RAG_REINDEX_OPERATOR_IDS=
